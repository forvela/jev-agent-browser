{
  "name": "jev-agent-browser",
  "version": "0.2.0",
  "description": "Configurable Jev browser research and classification CLI",
  "author": "forvela",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/forvela/jev-agent-browser.git"
  },
  "bugs": {
    "url": "https://github.com/forvela/jev-agent-browser/issues"
  },
  "type": "module",
  "bin": {
    "jev": "src/cli.js"
  },
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "profiles",
    "skills",
    "fixture",
    "agent-browser.json",
    "README.md",
    "CHANGELOG.md"
  ],
  "keywords": [
    "jev",
    "agent-browser",
    "browser-automation",
    "browser-agent",
    "research",
    "classification",
    "cli"
  ],
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@typesafe-ai/sdk": "^0.6.0"
  },
  "peerDependencies": {
    "agent-browser": ">=0.38.1"
  },
  "scripts": {
    "start": "node src/cli.js",
    "test": "node --test",
    "test:unit": "node --test test/loop.test.js",
    "test:contract": "node --test test/contract.test.js",
    "test:jsonl": "node --test test/jsonl.test.js",
    "smoke": "node src/smoke.js",
    "smoke:all": "npm run test && npm run smoke"
  }
}
